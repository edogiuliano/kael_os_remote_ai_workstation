NODE_ENV=development
HOST=0.0.0.0
PORT=8787
API_TOKEN=replace-with-a-long-random-token

# Optional Telegram integration. Keep empty to disable the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_STREAM_CHAT_ID=

# Optional notification integration.
DISCORD_WEBHOOK_URL=

# Agent commands. Override if your CLIs live outside PATH.
CODEX_COMMAND=codex
CLAUDE_COMMAND=claude
POWERSHELL_COMMAND=powershell.exe

# Optional local service URLs.
COMFYUI_URL=http://127.0.0.1:8188
OLLAMA_URL=http://127.0.0.1:11434
